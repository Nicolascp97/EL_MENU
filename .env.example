# ── Supabase ──────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # solo en servidor, nunca exponer al cliente

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://elmenu.cl   # sin trailing slash
NEXT_PUBLIC_WA_NUMBER=56954952395       # número WhatsApp sin + ni espacios

# ── IA / Anthropic ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── n8n (webhooks WhatsApp) ───────────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL=https://n8n.tudominio.com
N8N_WEBHOOK_SECRET=secreto-compartido-con-n8n

# ── Transbank Webpay Plus ─────────────────────────────────────────────────────
# Si TRANSBANK_ENVIRONMENT != "production", usa credenciales de integración de
# Transbank (tarjeta de prueba 4051 8856 0000 0044 / CVV 123 / 11/27).
# Para producción, obtener en https://www.transbank.cl/web/transbank-developers
TRANSBANK_ENVIRONMENT=integration     # "integration" | "production"
TRANSBANK_COMMERCE_CODE=             # solo para producción
TRANSBANK_API_KEY_SECRET=            # solo para producción
